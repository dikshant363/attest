{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@attest/shared": ["packages/shared/src/index.ts"],
      "@attest/project-world": ["packages/project-world/src/index.ts"],
      "@attest/model-router": ["packages/model-router/src/index.ts"],
      "@attest/tool-runtime": ["packages/tool-runtime/src/index.ts"],
      "@attest/verification": ["packages/verification/src/index.ts"],
      "@attest/evidence": ["packages/evidence/src/index.ts"],
      "@attest/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@attest/observability": ["packages/observability/src/index.ts"],
      "@attest/core": ["packages/core/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "apps", "examples", "dist"]
}
